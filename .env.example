# 로깅 모드
LOGGING_MODE = debug
LOGGER_NAME = app

# 데이터베이스
DATABASE_URL = "postgresql+asyncpg://admin:qwer1234@localhost:5432/karakpe"
POOL_SIZE=10
MAX_OVERFLOW=20

# 토스페이먼츠: 개발자센터의 테스트 시크릿 키를 로컬 .env에 입력
TOSS_SECRET_KEY=
# /v1/payments/checkout 결제창에서 사용하는 같은 상점의 API 개별 연동 클라이언트 키
# 개발자센터 > 내 개발정보 > API 키에서 test_ck_로 시작하는 테스트 키를 로컬 .env에 입력하세요.
TOSS_CLIENT_KEY=
TOSS_TIMEOUT_SECONDS=15

# JWT_SECRET_KEY: 각 팀원이 아래 명령으로 생성해 본인의 로컬 .env에 설정하세요.
# uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
# 생성한 키는 팀원끼리 공유하거나 커밋하지 마세요. 이 예시값을 실제 환경에서 사용하지 마세요.
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_64_bytes_long_before_use
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600
JWT_ISSUER=be-project-teamd
JWT_AUDIENCE=be-project-teamd-api
